{
  "name": "genain3-air",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "AI Integration Review — A GenAI:N3 resource. A browser-based tool for reflecting on AI in programme and module design.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenmccarthy/genain3-air.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/third-party-notices.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
